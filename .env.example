# Copy this file to .env and fill in your real values, then
# `docker compose up -d --build`. Anything left blank simply degrades
# gracefully (that section hides itself on the dashboard).

# --- Weather (Open-Meteo, no key required) ---
LATITUDE=52.52
LONGITUDE=13.405
LOCATION_LABEL=Zuhause

# --- Calendars (ICS feed URLs) ---
CALENDAR_ICS_URL=
WASTE_ICS_URL=

# --- NINA/BBK civil-protection alerts ---
# 12-digit Amtlicher Gemeindeschlüssel (AGS) for your municipality.
AGS_CODE=

# --- Joke source ---
# Returns one random joke as plain text on every call. Falls back to
# JokeAPI.dev automatically if this is unreachable or empty.
JOKE_API_URL=https://nopunintended.xyz

# --- Home Assistant (indoor temp/humidity) ---
# Leave HA_URL/HA_TOKEN/HA_TEMP_ENTITY blank to hide the "Innen" stat.
HA_URL=
HA_TOKEN=
HA_TEMP_ENTITY=sensor.hallway_temperature
HA_HUMIDITY_ENTITY=sensor.hallway_humidity

# --- Display ---
CLOCK_FORMAT=24h
ACCENT_COLOR=#F5A524
